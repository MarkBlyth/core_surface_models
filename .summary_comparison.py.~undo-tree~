def get_core_surf_ode(
    params: thermalparams.ThermalParameters,
    heatgen: float,
) -> Callable[[npt.ArrayLike, npt.ArrayLike], npt.ArrayLike]:
    htc = (params.h0 + params.hL) / params.L

    def ode_rhs(t, x):
        T0, c1 = x
        dT0dt = (heatgen - htc * T0) / (params.rho * params.cp)
        dc1dt = (
            -htc * c1
            - params.L * heatgen * (2 * params.h0 - params.hL) / 6
            + (params.h0**2 - params.h0 * params.hL + params.hL**2) * T0 / 3
        ) / (params.rho * params.cp)
        return dT0dt, dc1dt

    return ode_rhs


def solve_small_biot_core_surf(
    params: thermalparams.ThermalParameters, heatgen: float, t_eval: npt.ArrayLike
) -> Tuple[scipy.integrate.OdeSolution, npt.ArrayLike]:
    # define k, h0, hL, L; get soln with dense output

    ode = get_core_surf_ode(params, heatgen)
    soln = scipy.integrate.solve_ivp(
        ode,
        [t_eval[0], t_eval[-1]],
        [0, 0],
        t_eval=t_eval,
        dense_output=True,
        atol=TOL,
        rtol=TOL,
    )

    def T(x, t):
        T0, c1 = soln.sol(t)
        T1 = c1 + h0 * T0 * x - 0.5 * (params.h0 + params.hL) * T0 * x**2 / params.L
        return T0 + T1 / params.k

    return soln, T


def solve_thermal(
    projection: thermalparams.GalerkinProjection,
    heatgen: float,
    T_ambient: float,
    t_eval: npt.NDArray,
):
    A, b = projection.get_model_matrices()
    soln = scipy.integrate.solve_ivp(
        lambda t, x: np.matmul(A, (x - T_ambient)) + b * heatgen,
        [t_eval[0], t_eval[-1]],
        [T_ambient, T_ambient],
        t_eval=t_eval,
        atol=TOL,
        rtol=TOL,
    )
