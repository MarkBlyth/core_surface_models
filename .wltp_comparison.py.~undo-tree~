        lambda t, x: np.matmul(A, (x - T_ambient)) + b * heatgen_func(t),
        [t_eval[0], t_eval[-1]],
        [T_ambient, T_ambient],
        t_eval=t_eval,
        atol=TOL,
        rtol=TOL,
        max_step=MAX_STEP,
    )
    return soln.y
