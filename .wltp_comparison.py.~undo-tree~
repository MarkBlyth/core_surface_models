    gs = fig.add_gridspec(
        5,
        len(hs),
        height_ratios=[1, 1, 1, 1, 1],
        width_ratios=[1] * len(hs),
        right=0.9999,
    )

    axarrs = np.empty((4, len(hs)), dtype=object)
    for i in range(4):
        for j in range(len(hs)):
            axarrs[i, j] = fig.add_subplot(
                gs[i, j],
                sharex=axarrs[0, j] if i else None,
            )
            if i < 3:
                axarrs[i, j].tick_params(
                    axis=\"x\",
                    which=\"both\",
                    labelbottom=False,
                )

    for ax, h in zip(axarrs.T, hs):
        thermals = getthermals.get_thermals(h)

        heat_gen = pybamm.Interpolant(heatgen_ts, heatgen_qs, pybamm.t, \"Heat generation\")
        pybamm_soln = get_pybamm_soln(thermals, heatgen_ts, heatgen_qs, ts)
        surf_truth = pybamm_soln[\"Temperature\"](ts, 0)
        vol_truth = pybamm_soln[\"Volume averaged temperature\"](ts)

        ax[0].plot(
            ts,
            vol_truth,
            color=\"k\",
            linestyle=(0, (2, 3)),
            linewidth=2,
            label=\"Full model\",
            zorder=1000,
        )
        ax[2].plot(
            ts,
            surf_truth,
            color=\"k\",
            linestyle=(0, (3, 3)),
            linewidth=2,
            zorder=1000,
        )

        # TODO change this func to return core and surf from transformed model
        smallbiot_ode_soln, _ = solve_small_biot_core_surf(thermals, heatgen, ts)
        T0, c1 = smallbiot_ode_soln.y
        smallbiot_surf_temp = T0 + c1 / thermals.k
        smallbiot_vol_av_temp = (
            T0
            + (
                c1
                + 0.5 * thermals.L * thermals.h0 * T0
                - (thermals.h0 + thermals.hL) * T0 * thermals.L / 6
            )
            / thermals.k
        )
        ax[0].plot(
            ts,
            smallbiot_vol_av_temp,
            \"C0\",
            label=\"Small Biot\",
        )
        ax[1].plot(ts, smallbiot_vol_av_temp - vol_truth, \"C0\")
        ax[2].plot(ts, smallbiot_surf_temp, \"C0\")
        ax[3].plot(ts, smallbiot_surf_temp - surf_truth, \"C0\")

        two_eigens_projection = thermalparams.build_two_eigenmodes_model(thermals)
        eigenscore, eigensurf = solve_thermal(two_eigens_projection, heatgen, 0, ts)
        ax[0].plot(
            ts,
            eigenscore,
            \"C1\",
            label=r\"$\\{\\phi_1,\\phi_2\\}$ Galerkin\",
        )
        ax[1].plot(ts, eigenscore - vol_truth, \"C1\")
        ax[2].plot(ts, eigensurf, \"C1\")
        ax[3].plot(ts, eigensurf - surf_truth, \"C1\")

        eigen_steadystate_projection = (
            thermalparams.build_eigenmode_steadystatemode_model(thermals)
        )
        sscore, sssurf = solve_thermal(eigen_steadystate_projection, heatgen, 0, ts)
        ax[0].plot(
            ts,
            sscore,
            \"C2\",
            label=r\"$\\{\\phi_1,\\Psi\\}$ Galerkin\",
        )
        ax[1].plot(ts, sscore - vol_truth, \"C2\")
        ax[2].plot(ts, sssurf, \"C2\")
        ax[3].plot(ts, sssurf - surf_truth, \"C2\")

        ax[0].set_title(
            f\"h = {h}\\nBiot = {0.5*(thermals.h0 + thermals.hL)*thermals.L/thermals.k:.3f}\"
        )
        ax[3].set_xlabel(\"Time [s]\")

    ax_heatgen = fig.add_subplot(gs[4, :])
    ax_heatgen.plot(heatgen_ts, heatgen_qs, color=\"C5\")
