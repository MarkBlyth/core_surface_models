    hs = [10, 100, 1000]
    heatgen_ts, heatgen_qs = get_heating_func(
        \"wltp.csv\", \"MLP001_params.csv\", \"MLP001_ocv.csv\", 2.132
    )
    #ts = np.linspace(0, heatgen_ts[-1], 500)
    ts = heatgen_ts

    def heatgen(t):
        return np.interp(t, heatgen_ts, heatgen_qs)


