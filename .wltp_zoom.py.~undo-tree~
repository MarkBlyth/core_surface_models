([nil nil ((#("def get_pybamm_soln(
    thermals: thermalparams.ThermalParameters,
    heatgen_ts: npt.NDArray,
    heatgen_qs: npt.NDArray,
    t_eval: npt.ArrayLike,
) -> pybamm.Solution:
    heat_gen = pybamm.Interpolant(heatgen_ts, heatgen_qs, pybamm.t, \"Heat generation\")
    params = pybamm.ParameterValues(
        {
            \"Density\": thermals.rho,
            \"Specific heat capacity\": thermals.cp,
            \"Thermal conductivity\": thermals.k,
            # W/m3; chosen as 1W generated in an LG M50 jelly roll, volume 2.13e-5 m3 [1]
            \"Heat generation\": heat_gen,  # Volumetric
            \"LHS HTC\": thermals.h0,
            \"RHS HTC\": thermals.hL,
            \"Domain size\": thermals.L,
        }
    )

    x = pybamm.SpatialVariable(\"x\", domain=\"bulk\", coord_sys=\"cartesian\")
    T = pybamm.Variable(\"Temperature\", domain=\"bulk\")
    rho = pybamm.Parameter(\"Density\")
    cp = pybamm.Parameter(\"Specific heat capacity\")
    k = pybamm.Parameter(\"Thermal conductivity\")
    Q = pybamm.Parameter(\"Heat generation\")
    h0 = pybamm.Parameter(\"LHS HTC\")
    hL = pybamm.Parameter(\"RHS HTC\")
    L = pybamm.Parameter(\"Domain size\")

    heatflux = -k * pybamm.grad(T)
    dTdt = (-pybamm.div(heatflux) + Q) / (rho * cp)
    model = pybamm.BaseModel()
    model.rhs = {T: dTdt}
    model.boundary_conditions = {
        T: {
            \"left\": (
                (h0 / k) * pybamm.BoundaryValue(T, \"left\"),
                \"Neumann\",
            ),
            \"right\": (
                -(hL / k) * pybamm.BoundaryValue(T, \"right\"),
                \"Neumann\",
            ),
        }
    }
    model.initial_conditions = {T: 0}
    model.variables = {
        \"Temperature\": T,
        \"Volume averaged temperature\": pybamm.Integral(T, x) / L,
    }

    geometry = {\"bulk\": {x: {\"min\": pybamm.Scalar(0), \"max\": L}}}
    params.process_model(model)
    params.process_geometry(geometry)

    submesh_types = {\"bulk\": pybamm.Uniform1DSubMesh}
    var_pts = {x: 250}
    mesh = pybamm.Mesh(geometry, submesh_types, var_pts)
    spatial_methods = {\"bulk\": pybamm.FiniteVolume()}
    disc = pybamm.Discretisation(mesh, spatial_methods)
    disc.process_model(model)

    solver = pybamm.ScipySolver(
        atol=TOL, rtol=TOL, extra_options={\"max_step\": MAX_STEP}
    )
    return solver.solve(model, t_eval)


def get_core_surf_ode(
    params: thermalparams.ThermalParameters,
    heatgen: float,
) -> Callable[[npt.ArrayLike, npt.ArrayLike], npt.ArrayLike]:
    htc = (params.h0 + params.hL) / params.L

    def ode_rhs(t, x):
        T0, c1 = x
        dT0dt = (heatgen - htc * T0) / (params.rho * params.cp)
        dc1dt = (
            -htc * c1
            - params.L * heatgen * (2 * params.h0 - params.hL) / 6
            + (params.h0**2 - params.h0 * params.hL + params.hL**2) * T0 / 3
        ) / (params.rho * params.cp)
        return dT0dt, dc1dt

    return ode_rhs


def get_core_surf_ode(
    params: thermalparams.ThermalParameters,
    heatgen_func: Callable[[float], float],
) -> Callable[[npt.ArrayLike, npt.ArrayLike], npt.ArrayLike]:
    htc = (params.h0 + params.hL) / params.L

    def ode_rhs(t, x):
        heatgen = heatgen_func(t)
        T0, c1 = x
        dT0dt = (heatgen - htc * T0) / (params.rho * params.cp)
        dc1dt = (
            -htc * c1
            - params.L * heatgen * (2 * params.h0 - params.hL) / 6
            + (params.h0**2 - params.h0 * params.hL + params.hL**2) * T0 / 3
        ) / (params.rho * params.cp)
        return dT0dt, dc1dt

    return ode_rhs


def solve_small_biot_core_surf(
    params: thermalparams.ThermalParameters,
    heatgen_func: Callable[[float], float],
    t_eval: npt.ArrayLike,
) -> Tuple[scipy.integrate.OdeSolution, npt.ArrayLike]:
    # define k, h0, hL, L; get soln with dense output

    ode = get_core_surf_ode(params, heatgen_func)
    soln = scipy.integrate.solve_ivp(
        ode,
        [t_eval[0], t_eval[-1]],
        [0, 0],
        t_eval=t_eval,
        dense_output=True,
        atol=TOL,
        rtol=TOL,
        max_step=MAX_STEP,
    )

    def T(x, t):
        T0, c1 = soln.sol(t)
        T1 = c1 + h0 * T0 * x - 0.5 * (params.h0 + params.hL) * T0 * x**2 / params.L
        return T0 + T1 / params.k

    return soln, T


def solve_thermal(
    projection: thermalparams.GalerkinProjection,
    heatgen_func: Callable[[float], float],
    T_ambient: float,
    t_eval: npt.NDArray,
):
    A, b = projection.get_model_matrices()
    soln = scipy.integrate.solve_ivp(
        lambda t, x: np.matmul(A, (x - T_ambient)) + b * heatgen_func(t),
        [t_eval[0], t_eval[-1]],
        [T_ambient, T_ambient],
        t_eval=t_eval,
        atol=TOL,
        rtol=TOL,
        max_step=MAX_STEP,
    )
    return soln.y


